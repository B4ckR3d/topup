{
  "name": "umbreon-store",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:apps": "turbo run build --filter=web-api --filter=web-admin --filter=web-client",
    "dev": "turbo run dev --filter=web-api --filter=web-admin --filter=web-client",
    "dev:all": "turbo run dev",
    "dev:api": "turbo run dev --filter=web-api",
    "dev:admin": "turbo run dev --filter=web-admin",
    "dev:client": "turbo run dev --filter=web-client",
    "lint": "turbo run lint",
    "lint:apps": "turbo run lint --filter=web-api --filter=web-admin --filter=web-client",
    "lint:fix": "turbo run lint:fix",
    "lint:root": "biome lint .",
    "start": "turbo run start",
    "start:apps": "turbo run start --filter=web-api --filter=web-admin --filter=web-client",
    "format": "turbo run format",
    "format:root": "biome format --write .",
    "check": "biome check .",
    "check:apps": "turbo run check --filter=web-api --filter=web-admin --filter=web-client",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm --filter web-admin --filter web-client run typecheck",
    "test": "pnpm --filter web-api --filter web-admin run test",
    "test:api": "pnpm --filter web-api run test",
    "test:admin": "pnpm --filter web-admin run test",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "ui": "npm run -w @umbreon/ui ui --",
    "db:pull": "npm run -w @umbreon/db db:pull",
    "db:migrate": "npm run -w @umbreon/db db:migrate",
    "db:push": "npm run -w @umbreon/db db:push",
    "db:generate": "npm run -w @umbreon/db db:generate",
    "db:seed": "npm run -w @umbreon/db db:seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose run --rm migration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "husky": "^9.1.7",
    "skills": "^1.5.7",
    "turbo": "^2.7.2",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.26.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli/*"
  ],
  "overrides": {
    "zod": "^4.0.14",
    "@types/node": "22.15.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core"
    ]
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  }
}
